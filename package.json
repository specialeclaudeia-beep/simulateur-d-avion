{
  "name": "simulateur-compagnie-aerienne",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Simulateur de compagnie aérienne : jeu web gratuit, mobile et ordinateur.",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/b612-mono": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "maplibre-gl": "6.16.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.0.5"
  }
}
